{
  "name": "luseen",
  "version": "0.1.4",
  "description": "Generate spec-driven development documents for an existing project, using Claude",
  "keywords": [
    "claude",
    "ai",
    "spec-driven-development",
    "sdd",
    "cli",
    "specs"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Hayko97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hayko97/cclinic.git"
  },
  "homepage": "https://github.com/Hayko97/cclinic#readme",
  "bugs": {
    "url": "https://github.com/Hayko97/cclinic/issues"
  },
  "type": "module",
  "bin": {
    "luseen": "bin/luseen.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/build-plugin.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "build:plugin": "tsup && node dist/build-plugin.js",
    "test": "vitest run --project unit --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:mutation": "stryker run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run lint && npm run typecheck && npm run check:arch && npm run test:coverage && npm run test:e2e",
    "setup:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "ignore": "^7.0.14",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
