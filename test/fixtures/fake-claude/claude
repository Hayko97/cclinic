#!/usr/bin/env node
// A stand-in for the Claude CLI, for tests. It costs nothing and never touches the network.
// FAKE_CLAUDE_MODE: ok (default), fail-after-1, hang, slow, invalid-model, auth-error, invalid-output, usage-limit
// FAKE_CLAUDE_SCRIPT: a JSON file of rules for agent calls. Each call uses the first rule whose `match`
// (a regex on the prompt) fits and that has uses left (`times`, default 1, 0 for unlimited). A rule can
// set `output` (structured output), `message`, `cost`, `exitCode`, `delayMs`, `hang`, `silent` (exit with no
// result line), `events` (stream events written before the result, such as a `rate_limit_event`) and `write`
// (files to write, relative to the working folder).
// Planning turns (roadmap-planning): with --session-id or --resume, the call is written to a Claude Code-style
// transcript under CLAUDE_CONFIG_DIR (or HOME/.claude). A rule can also set `toolUses` (tool calls written to the
// stream and the transcript, such as Read) and `tools` (MCP tool calls made through the server in --mcp-config;
// `planId` is filled in from its --plan argument). Their results go to FAKE_CLAUDE_RECORD + ".tools.jsonl".
// The user's message is written when the turn starts, unless `beforeTranscript` is set.
const fs = require("node:fs");

const args = process.argv.slice(2);
const mode = process.env.FAKE_CLAUDE_MODE ?? "ok";
const record = process.env.FAKE_CLAUDE_RECORD;

if (args[0] === "--version") {
  console.log(process.env.FAKE_CLAUDE_VERSION ?? "2.1.319 (Claude Code)");
  process.exit(0);
}
if (args[0] === "auth") {
  const loggedIn = process.env.FAKE_CLAUDE_LOGGED_OUT === undefined;
  const authMethod = process.env.ANTHROPIC_API_KEY ? "api_key" : loggedIn ? "claude.ai" : "none";
  console.log(JSON.stringify({ loggedIn, authMethod }));
  process.exit(loggedIn ? 0 : 1);
}

const prompt = fs.readFileSync(0, "utf8");
const callNumber = () => {
  if (!record) return 1;
  return fs.existsSync(record) ? fs.readFileSync(record, "utf8").split("\n").filter(Boolean).length : 0;
};
const count = callNumber();
if (record) {
  const env = Object.fromEntries(
    ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_MAX_RETRIES", "CLAUDE_CODE_MAX_OUTPUT_TOKENS", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"].map(
      (key) => [key, process.env[key] ?? null],
    ),
  );
  const cwdEntries = fs.readdirSync(process.cwd());
  // In an auto run the agent works in <run>/worktrees/task-N, and its session file is in <run>/sessions.
  const sessionId = args.includes("--session-id") ? args[args.indexOf("--session-id") + 1] : null;
  const sessionRecorded = sessionId === null ? null : fs.existsSync(require("node:path").join(process.cwd(), "..", "..", "sessions", `${sessionId}.json`));
  fs.appendFileSync(record, `${JSON.stringify({ args, cwd: process.cwd(), cwdEntries, env, prompt, watched: process.env.FAKE_CLAUDE_WATCH ? fs.existsSync(process.env.FAKE_CLAUDE_WATCH) : null, sessionRecorded })}\n`);
}

const emit = (event) => process.stdout.write(`${JSON.stringify(event)}\n`);

const scriptFile = process.env.FAKE_CLAUDE_SCRIPT;
// FAKE_CLAUDE_FALLBACK: a call no rule matches, such as generation's, gets the default behaviour below instead.
script: if (scriptFile) {
  const pause = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
  const lock = `${scriptFile}.lock`;
  for (;;) {
    try {
      fs.mkdirSync(lock);
      break;
    } catch {
      pause(5);
    }
  }
  const stateFile = `${scriptFile}.state`;
  const rules = JSON.parse(fs.readFileSync(scriptFile, "utf8"));
  const used = fs.existsSync(stateFile) ? JSON.parse(fs.readFileSync(stateFile, "utf8")) : {};
  const index = rules.findIndex((rule, position) => {
    const times = rule.times ?? 1;
    const isLeft = times === 0 || (used[position] ?? 0) < times;
    return isLeft && (rule.match === undefined || new RegExp(rule.match, "s").test(prompt));
  });
  if (index !== -1) used[index] = (used[index] ?? 0) + 1;
  fs.writeFileSync(stateFile, JSON.stringify(used));
  fs.rmdirSync(lock);
  const rule = rules[index];
  if (rule === undefined && process.env.FAKE_CLAUDE_FALLBACK) break script;
  if (rule === undefined) {
    emit({ type: "result", is_error: true, subtype: "success", result: "No script rule matched this prompt." });
    process.exit(1);
  }
  if (process.env.FAKE_CLAUDE_PIDS) fs.appendFileSync(process.env.FAKE_CLAUDE_PIDS, `${process.pid}\n`);
  const nodePath = require("node:path");
  const sessionId = args.includes("--resume") ? args[args.indexOf("--resume") + 1] : args.includes("--session-id") ? args[args.indexOf("--session-id") + 1] : null;
  // Like Claude Code, the user's message is in the transcript as soon as the turn starts; the replies follow.
  const line = (type, content) => {
    if (sessionId === null || args.includes("--no-session-persistence")) return;
    const config = process.env.CLAUDE_CONFIG_DIR || nodePath.join(process.env.HOME, ".claude");
    const folder = nodePath.join(config, "projects", fs.realpathSync(process.cwd()).replace(/[^a-zA-Z0-9]/g, "-"));
    fs.mkdirSync(folder, { recursive: true });
    const file = nodePath.join(folder, `${sessionId}.jsonl`);
    fs.appendFileSync(file, `${JSON.stringify({ type, timestamp: new Date().toISOString(), sessionId, message: { role: type, content } })}\n`);
  };
  // `beforeTranscript`: the turn is stopped before Claude Code wrote anything, such as while it starts up.
  if (!rule.beforeTranscript) line("user", prompt);
  if (rule.hang) {
    setInterval(() => {}, 1000);
    return;
  }
  const transcript = () => {
    for (const use of rule.toolUses ?? []) line("assistant", [{ type: "tool_use", id: "t", name: use.name, input: use.input ?? {} }]);
    for (const call of rule.tools ?? []) line("assistant", [{ type: "tool_use", id: "m", name: `mcp__luseen__${call.name}`, input: call.input ?? {} }]);
    if (rule.message !== undefined && rule.message !== "") line("assistant", [{ type: "text", text: rule.message }]);
  };
  /** Calls the scripted MCP tools through the server in --mcp-config, over newline-delimited JSON-RPC. */
  const callTools = async () => {
    if (!rule.tools || !args.includes("--mcp-config")) return;
    const config = JSON.parse(args[args.indexOf("--mcp-config") + 1]);
    const server = Object.values(config.mcpServers)[0];
    const planId = server.args[server.args.indexOf("--plan") + 1];
    const child = require("node:child_process").spawn(server.command, server.args, { stdio: ["pipe", "pipe", "inherit"] });
    let buffer = "";
    const waiting = new Map();
    child.stdout.on("data", (chunk) => {
      buffer += chunk;
      for (let at = buffer.indexOf("\n"); at !== -1; at = buffer.indexOf("\n")) {
        const message = JSON.parse(buffer.slice(0, at));
        buffer = buffer.slice(at + 1);
        waiting.get(message.id)?.(message);
      }
    });
    let id = 0;
    const request = (method, params) =>
      new Promise((resolve) => {
        id += 1;
        waiting.set(id, resolve);
        child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`);
      });
    await request("initialize", { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "fake-claude", version: "1" } });
    child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", method: "notifications/initialized" })}\n`);
    for (const call of rule.tools) {
      emit({ type: "assistant", message: { content: [{ type: "tool_use", name: `mcp__luseen__${call.name}`, input: call.input ?? {} }] } });
      const answer = await request("tools/call", { name: call.name, arguments: { planId, ...(call.input ?? {}) } });
      if (record) fs.appendFileSync(`${record}.tools.jsonl`, `${JSON.stringify({ name: call.name, result: answer.result ?? answer.error })}\n`);
    }
    child.stdin.end();
    child.kill();
  };
  const respond = async () => {
    for (const use of rule.toolUses ?? []) emit({ type: "assistant", message: { content: [{ type: "tool_use", name: use.name, input: use.input ?? {} }] } });
    await callTools();
    transcript();
    for (const [file, content] of Object.entries(rule.write ?? {})) {
      fs.mkdirSync(require("node:path").dirname(file), { recursive: true });
      fs.writeFileSync(file, content);
    }
    const isError = (rule.exitCode ?? 0) !== 0;
    for (const event of rule.events ?? []) emit(event);
    if (rule.silent) process.exit(rule.exitCode ?? 1);
    emit({
      type: "result",
      is_error: isError,
      subtype: "success",
      result: rule.message ?? "Done.",
      ...(rule.apiErrorStatus === undefined ? {} : { api_error_status: rule.apiErrorStatus }),
      ...(rule.output === undefined ? {} : { structured_output: rule.output }),
      total_cost_usd: rule.cost ?? 0.01,
    });
    process.exit(rule.exitCode ?? 0);
  };
  if (rule.delayMs) setTimeout(() => void respond(), rule.delayMs);
  else void respond();
  return;
}
const fail = (fields, code = 1) => {
  emit({ type: "result", is_error: true, subtype: "success", structured_output: null, ...fields });
  process.exit(code);
};

if (mode === "retry-events") {
  emit({ type: "system", subtype: "api_retry", attempt: 1, max_retries: 2, retry_delay_ms: Number(process.env.FAKE_CLAUDE_DELAY_MS ?? 0), error: "rate_limit" });
}
if (mode === "hang") {
  setInterval(() => {}, 1000);
  return;
}
if (mode === "invalid-model") fail({ api_error_status: 404, result: "There's an issue with the selected model." });
if (mode === "auth-error") fail({ api_error_status: 401, result: "Invalid credentials" });
if (mode === "usage-limit") fail({ api_error_status: 429, result: "You've hit your session limit. Resets at 5pm." });
if (mode === "fail-after-1" && count >= 1) fail({ api_error_status: 500, result: "Server error" });
if (mode === "invalid-output") {
  emit({ type: "result", is_error: false, subtype: "success", structured_output: { nonsense: true }, total_cost_usd: 0.01, modelUsage: { "claude-sonnet-5-5": {} } });
  process.exit(0);
}

// The design step runs with tools and no schema. FAKE_CLAUDE_DESIGN: valid (default), invalid, none, fail
if (!args.includes("--json-schema") && prompt.startsWith("Create the design system for the project")) {
  const outcome = process.env.FAKE_CLAUDE_DESIGN ?? "valid";
  // Files are written before a failure, as a run that stops partway does.
  for (const file of (process.env.FAKE_CLAUDE_ALSO_WRITE ?? "").split(",").filter(Boolean)) fs.writeFileSync(file, "changed by the agent\n");
  if (outcome === "fail") fail({ api_error_status: 500, result: "Server error" });
  const sections = ["Status", "Principles", "Color", "Typography", "Spacing and layout", "Shape and elevation", "Motion", "Accessibility", "Components", "Templates", "Decisions", "Sources", "Open questions"];
  const markdown = sections.map((section) => `## ${section}\n\n${section === "Status" ? "draft" : "Written by the fake agent."}\n`).join("\n");
  const tokens = { color: { $type: "color", blue: { 600: { $value: "#2563eb" } }, text: { default: { $value: "{color.blue.600}" } } } };
  if (outcome !== "none") {
    fs.mkdirSync(".luseen/design", { recursive: true });
    fs.writeFileSync(".luseen/design/design-system.md", `# Design system\n\n${markdown}`);
    fs.writeFileSync(".luseen/design/design.tokens.json", outcome === "invalid" ? "{ not json" : JSON.stringify(tokens));
    fs.writeFileSync(".luseen/design/style-guide.html", "<!doctype html><title>Style guide</title>");
  }
  emit({ type: "result", is_error: false, subtype: "success", result: "I couldn't finish the design system.", total_cost_usd: 0.3 });
  process.exit(0);
}

// The environment step runs with tools and no schema. FAKE_CLAUDE_ENVIRONMENT: valid (default), invalid, none, fail
if (!args.includes("--json-schema")) {
  const outcome = process.env.FAKE_CLAUDE_ENVIRONMENT ?? "valid";
  if (outcome === "fail") fail({ api_error_status: 500, result: "Server error" });
  const part = { name: "web", type: "web", start: "docker compose up", stop: "docker compose down", url: "http://sample.localhost:3000", fallbackUrl: "http://localhost:3000", review: "Open the link" };
  const contents = { valid: JSON.stringify({ version: 1, alias: "sample", parts: [part] }), invalid: JSON.stringify({ version: 1, alias: "Bad Alias", parts: [] }) };
  if (contents[outcome]) {
    fs.mkdirSync(".luseen/environment", { recursive: true });
    fs.writeFileSync(".luseen/environment/environment.json", contents[outcome]);
  }
  for (const file of (process.env.FAKE_CLAUDE_ALSO_WRITE ?? "").split(",").filter(Boolean)) fs.writeFileSync(file, "changed by the agent\n");
  emit({ type: "result", is_error: false, subtype: "success", result: "I couldn't tell what runs here.", total_cost_usd: 0.25 });
  process.exit(0);
}

const schema = JSON.parse(args[args.indexOf("--json-schema") + 1]);
const keys = Object.keys(schema.properties);
const fileFromPrompt = () => {
  const inContent = /<file path="([^"]+)"/.exec(prompt);
  if (inContent) return inContent[1];
  const inList = /^- (.+)$/m.exec(prompt.slice(prompt.indexOf("Files analysed")));
  return inList ? inList[1] : "unknown";
};
const evidence = [`${fileFromPrompt()}:1`];

let data;
if (keys.includes("capabilities")) {
  data = {
    purpose: "Does a thing.",
    capabilities: [{ name: "thing", description: "Does the thing", evidence }],
    dataAndInterfaces: [],
    businessRules: [],
    technologies: [],
    conventions: [],
    commands: [],
  };
} else if (keys.includes("overview")) {
  data = {
    overview: { purpose: "A sample project.", users: ["Developers"], scope: ["Things"], nonGoals: [], glossary: [] },
    stack: [{ category: "Language", name: "JavaScript", version: "unknown", evidence }],
    architecture: { parts: [], dataFlow: [], externalSystems: [], problems: [] },
    guidelines: [{ section: "Naming", guidance: "Use camelCase.", label: "observed", evidence }],
    specs: [{ name: "core-feature", area: "CORE", goal: "Do the thing.", modules: [] }],
    openQuestions: [],
  };
} else {
  data = {
    goal: "Do the thing.",
    requirements: [{ id: "FR-CORE-001", statement: "It must do the thing.", status: "code-only", evidence }],
    edgeCases: [],
    nonGoals: [],
    testSetup: [],
    acceptanceCriteria: [{ id: "VAL-CORE-001", covers: ["FR-CORE-001"], userNeed: "I need the thing", acceptedWhen: "The thing happens" }],
    testCases: [{ id: "TC-CORE-001", covers: ["FR-CORE-001"], level: "unit", given: "A setup", when: "It runs", then: "The thing happens" }],
    openQuestions: [],
  };
}

const finish = () => {
  emit({ type: "system", subtype: "init" });
  emit({
    type: "result",
    is_error: false,
    subtype: "success",
    stop_reason: "tool_use",
    structured_output: data,
    total_cost_usd: 0.01,
    modelUsage: { "claude-sonnet-5-5": {} },
    usage: { input_tokens: 10, output_tokens: 20, cache_creation_input_tokens: 0, cache_read_input_tokens: 0 },
  });
  process.exit(0);
};
if (mode === "slow") setTimeout(finish, Number(process.env.FAKE_CLAUDE_DELAY_MS ?? 3000));
else finish();
